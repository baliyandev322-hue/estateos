# ==============================================================================
# EstateOS Enterprise Production Environment Configuration
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL - Supabase / AWS RDS / Neon / Local) ---
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public&sslmode=require
# Example Supabase pooled connection string:
DATABASE_URL="postgresql://postgres.yourproject:YourStrongPassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"

# Direct connection string for Prisma migrations (bypassing pgbouncer):
DIRECT_URL="postgresql://postgres:YourStrongPassword@db.yourproject.supabase.co:5432/postgres"

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET="estateos-super-secure-production-secret-2026-min-32-chars-long"

# --- PLATFORM DOMAIN ---
NEXT_PUBLIC_SITE_URL="https://estateos.in"

# --- PAYMENT GATEWAY (Razorpay India) ---
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# --- GOOGLE ADSENSE & ADS ---
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-7890123456789012"

# --- AI LLM API (Optional for extra generative features) ---
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# --- WHATSAPP & SMS (Twilio / Gupshup) ---
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
