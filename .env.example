# ==============================================================================
# EstateOS Enterprise Production Environment Configuration
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL - Supabase / AWS RDS / Neon / Local) ---
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public&sslmode=require
# Example Supabase pooled connection string:
DATABASE_URL="postgresql://postgres.yourproject:YourStrongPassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"

# Direct connection string for Prisma migrations (bypassing pgbouncer):
DIRECT_URL="postgresql://postgres:YourStrongPassword@db.yourproject.supabase.co:5432/postgres"

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET="estateos-super-secure-production-secret-2026-min-32-chars-long"

# --- PLATFORM DOMAIN ---
NEXT_PUBLIC_SITE_URL="https://estateos.in"

# --- PHONEPE PAYMENT GATEWAY (India UPI / QR / NetBanking / Cards) ---
# Default UAT Sandbox credentials provided for test development. Replace with Production Merchant keys upon approval.
PHONEPE_MERCHANT_ID="PGTESTPAYUAT86"
PHONEPE_SALT_KEY="96434309-7796-489d-8924-ab56988a6076"
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="UAT" # Switch to "PRODUCTION" when live credentials are active

# --- PAYMENT GATEWAY (Razorpay India - Optional Fallback) ---
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# --- GOOGLE ADSENSE & ADS ---
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-7890123456789012"

# --- AI LLM API (Optional for extra generative features) ---
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# --- WHATSAPP & SMS (Twilio / Gupshup) ---
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- TELEGRAM BOT ALERTS (Founder Real-Time Push Alerts) ---
# Set via local .env or hosting environment variables dashboard. Never commit actual tokens.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
